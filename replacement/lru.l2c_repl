#include "cache.h"

// stats: L2 load misses after warmup, split by instruction vs data
uint64_t l2_instr_load_miss = 0, l2_data_load_miss = 0;

// initialize replacement state
void CACHE::l2c_initialize_replacement()
{
	cout << NAME << " has LRU replacement policy" << endl;
}

// find replacement victim
uint32_t CACHE::l2c_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{
    // baseline LRU
    return lru_victim(cpu, instr_id, set, current_set, ip, full_addr, type);
}

// called on every cache hit and cache fill
void CACHE::l2c_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit, uint8_t isInstruction)
{

    if ((type == WRITEBACK) && ip)
        assert(0);

    // STATS: a call with hit == 0 is the fill of a miss; count demand loads only, after warmup
    if (!hit && type == LOAD && warmup_complete[cpu]) {
        if (isInstruction) l2_instr_load_miss++; else l2_data_load_miss++;
    }

    // baseline LRU
    if (hit && (type == WRITEBACK)) // writeback hit does not update LRU state
        return;

    return lru_update(set, way);
}

void CACHE::l2c_replacement_final_stats()
{
    cout << "L2C_SPLIT instr_load_miss " << l2_instr_load_miss
         << " data_load_miss " << l2_data_load_miss << endl;
}