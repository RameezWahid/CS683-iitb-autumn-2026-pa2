#include "cache.h"

#define maxRRPV 3
uint32_t l2_rrpv[L2C_SET][L2C_WAY];
uint8_t  l2_is_instr[L2C_SET][L2C_WAY];   // 1 if the line holds instructions

// stats: L2 load misses after warmup, split by instruction vs data
uint64_t l2_instr_load_miss = 0, l2_data_load_miss = 0;

void CACHE::l2c_initialize_replacement()
{
    cout << "Initialize I-RRIP state for L2C" << endl;
    for (int i = 0; i < L2C_SET; i++)
        for (int j = 0; j < L2C_WAY; j++) {
            l2_rrpv[i][j] = maxRRPV;
            l2_is_instr[i][j] = 0;
        }
}

// EVICTION: among lines at maxRRPV, evict a data line first.
// Evict an instruction line only if every max-RRPV line is an instruction line.
uint32_t CACHE::l2c_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{
    while (1) {
        int instr_candidate = -1;
        for (int i = 0; i < L2C_WAY; i++) {
            if (l2_rrpv[set][i] == maxRRPV) {
                if (!l2_is_instr[set][i]) return i;      // data line: evict it
                if (instr_candidate < 0) instr_candidate = i;
            }
        }
        if (instr_candidate >= 0) return instr_candidate; // only instr lines at max
        for (int i = 0; i < L2C_WAY; i++) l2_rrpv[set][i]++; // Increase the RRPV of every way in this set
    }
    assert(0);
    return 0;
}

void CACHE::l2c_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit, uint8_t isInstruction)
{
    if ((type == WRITEBACK) && ip) assert(0);

    // STATS: a call with hit == 0 is the fill of a miss; count demand loads only, after warmup
    if (!hit && type == LOAD && warmup_complete[cpu]) {
        if (isInstruction) l2_instr_load_miss++; else l2_data_load_miss++;
    }

    if (hit) {
        // PROMOTION: instruction lines go straight to 0; data lines move one step closer
        if (isInstruction) l2_is_instr[set][way] = 1;     // line stays marked once it is instr
        if (l2_is_instr[set][way]) l2_rrpv[set][way] = 0;
        else if (l2_rrpv[set][way] > 0) l2_rrpv[set][way]--;
    } else {
        // INSERTION: instruction lines at 0 (kept longest), data lines at maxRRPV-1 as in SRRIP
        l2_is_instr[set][way] = isInstruction ? 1 : 0;
        l2_rrpv[set][way] = isInstruction ? 0 : maxRRPV - 1;
    }
}

void CACHE::l2c_replacement_final_stats()
{
    cout << "L2C_SPLIT instr_load_miss " << l2_instr_load_miss
         << " data_load_miss " << l2_data_load_miss << endl;
}