#include "cache.h"

#define IP_TABLE_SIZE 64     // rows in IP table (direct mapped)
#define PT_SIZE       512    // pattern table entries
#define SIG_MASK      0x1FF  // 9-bit signature
#define FILTER_SIZE   32     // recently prefetched lines remembered
#define EPOCH         256    // re-check accuracy every 256 prefetches

struct IPEntry {
    bool     valid;
    uint64_t tag;
    uint64_t last_line;   // last cache line accessed by this IP
    int64_t  stride;      // last seen stride (uniform detection)
    int      conf;        // uniform confidence 0..3
    uint32_t sig;         // signature of recent strides
    IPEntry() : valid(false), tag(0), last_line(0), stride(0), conf(0), sig(0) {}
};

struct PTEntry {
    int64_t next;         // predicted next stride
    int     conf;         // 0..3
    PTEntry() : next(0), conf(0) {}
};

static IPEntry  ip_table[IP_TABLE_SIZE];
static PTEntry  pt[PT_SIZE];
static uint64_t filt[FILTER_SIZE];
static uint32_t filt_ptr;
static uint32_t issued, useful;
static int      degree;
static uint64_t total_issued, total_useful;

// Signature = hash of previous signature and the new stride
static uint32_t next_sig(uint32_t sig, int64_t stride) {
    return ((sig << 3) ^ (uint32_t)(stride & 0x3F)) & SIG_MASK;
}

// Did a demand access hit a line we recently prefetched?
static void check_useful(uint64_t line) {
    for (int i = 0; i < FILTER_SIZE; i++) {
        if (filt[i] == line) { useful++; total_useful++; filt[i] = 0; return; }
    }
}

// Accuracy throttle: every EPOCH prefetches, pick a new degree
static void update_degree() {
    if (issued < EPOCH) return;
    int acc = (useful * 100) / issued;
    if      (acc >= 75) degree = 4;
    else if (acc >= 50) degree = 3;
    else if (acc >= 25) degree = 2;
    else                degree = 1;
    issued = 0;
    useful = 0;
}

void CACHE::l1d_prefetcher_initialize()
{
    cout << "CPU " << cpu << " L1D SPP prefetcher" << endl;
    for (int i = 0; i < FILTER_SIZE; i++) filt[i] = 0;
    filt_ptr = 0; issued = 0; useful = 0;
    total_issued = 0; total_useful = 0;
    degree = 2;
}

void CACHE::l1d_prefetcher_operate(uint64_t addr, uint64_t ip, uint8_t cache_hit, uint8_t type, uint8_t critical_ip_flag)
{
    uint64_t line = addr >> LOG2_BLOCK_SIZE;
    const int PAGE_SHIFT = LOG2_PAGE_SIZE - LOG2_BLOCK_SIZE;   // line -> page number

    check_useful(line);

    // 1. Find this IP's row
    int idx = ip % IP_TABLE_SIZE;
    uint64_t tag = (ip / IP_TABLE_SIZE) & 0xFF;
    IPEntry &e = ip_table[idx];

    if (!e.valid || e.tag != tag) {            // new IP: allocate and stop
        e = IPEntry();
        e.valid = true;
        e.tag = tag;
        e.last_line = line;
        return;
    }

    // 2. Page changed: restart this IP's history
    if ((line >> PAGE_SHIFT) != (e.last_line >> PAGE_SHIFT)) {
        e.last_line = line; e.sig = 0; e.conf = 0; e.stride = 0;
        return;
    }

    int64_t stride = (int64_t)line - (int64_t)e.last_line;
    e.last_line = line;
    if (stride == 0) return;

    // 3. Uniform stride check
    if (stride == e.stride) { if (e.conf < 3) e.conf++; }
    else { if (e.conf > 0) e.conf--; else e.stride = stride; }

    // 4. Train the pattern table: "signature -> this stride"
    PTEntry &p = pt[e.sig];
    if (p.next == stride) { if (p.conf < 3) p.conf++; }
    else { if (p.conf > 0) p.conf--; else p.next = stride; }
    e.sig = next_sig(e.sig, stride);

    // 5. Helper: issue one prefetch if it stays in the page
    auto issue = [&](uint64_t pf_line) -> bool {
        if ((pf_line >> PAGE_SHIFT) != (line >> PAGE_SHIFT)) return false;
        uint64_t pf_addr = pf_line << LOG2_BLOCK_SIZE;
        int ok;
        if (MSHR.occupancy < (MSHR.SIZE >> 1))
            ok = prefetch_line(ip, addr, pf_addr, FILL_L1, 0);
        else
            ok = prefetch_line(ip, addr, pf_addr, FILL_L2, 0);
        if (!ok) return false;
        filt[filt_ptr++ % FILTER_SIZE] = pf_line;
        issued++; total_issued++;
        update_degree();
        return true;
    };

    // 6. Generate prefetches
    if (e.conf >= 2) {
        // Uniform: A+s, A+2s, ...
        for (int i = 1; i <= degree; i++)
            if (!issue(line + e.stride * i)) break;
    } else {
        // Non-uniform: walk the pattern table
        uint32_t s = e.sig;
        uint64_t cur = line;
        for (int i = 0; i < degree; i++) {
            PTEntry &q = pt[s];
            if (q.conf < 1 || q.next == 0) break;
            cur += q.next;
            if (!issue(cur)) break;
            s = next_sig(s, q.next);
        }
    }
}

void CACHE::l1d_prefetcher_cache_fill(uint64_t v_addr, uint64_t addr, uint32_t set, uint32_t way, uint8_t prefetch, uint64_t v_evicted_addr, uint64_t evicted_addr, uint32_t metadata_in)
{
    return;
}

void CACHE::l1d_prefetcher_final_stats()
{
    cout << "CPU " << cpu << " L1D SPP final stats" << endl;
    cout << "Final degree: " << degree << endl;
    cout << "SPP issued: " << total_issued << " useful: " << total_useful << endl;
}